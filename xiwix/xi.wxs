<?xml version="1.0" encoding="utf-8"?>
<!--
  Force Feedback Driver for XInput - WiX v4 installer
  Installs both x64 and x86 DLLs and registers them as COM in-process servers.
  Per-controller OEMForceFeedback registry entries are optional features.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="!(loc.ProductName)"
           Version="1.0.1.0"
           Manufacturer="!(loc.ProductManufacturer)"
           UpgradeCode="{FFB10368-5623-49AA-BD51-B321DB9625CE}"
           Language="1033">

    <SummaryInformation Description="!(loc.PackageDescription)"
                        Comments="!(loc.PackageComments)"
                        Manufacturer="!(loc.PackageManufacturer)" />

    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed. Uninstall it first." />
    <MediaTemplate EmbedCab="yes" />

    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <ui:WixUI Id="WixUI_FeatureTree" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />

    <!-- Install directory layout under Program Files (x64) -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="Force Feedback Driver for XInput">

        <!-- x64 DLL + 64-bit COM registration in HKCR -->
        <Directory Id="Directory_x64" Name="x64">
          <Component Id="Binaries_x64" Guid="*">
            <File Id="xiffd_x64" Name="xiffd.dll" DiskId="1"
                  Source="..\build\Release\x64\xiffd.dll" />
            <RegistryKey Root="HKCR"
                         Key="CLSID\{FFB10360-5623-49AA-BD51-B321DB9625CE}"
                         ForceCreateOnInstall="yes" ForceDeleteOnUninstall="yes">
              <RegistryValue Type="string" Value="Force Feedback Driver for XInput" />
              <RegistryValue Key="InProcServer32" Type="string"
                             Value="[INSTALLDIR]x64\xiffd.dll" />
              <RegistryValue Key="InProcServer32" Name="ThreadingModel"
                             Type="string" Value="Both" />
            </RegistryKey>
          </Component>
        </Directory>

        <!-- x86 DLL + 32-bit COM registration under Wow6432Node -->
        <Directory Id="Directory_x86" Name="x86">
          <Component Id="Binaries_x86" Guid="*">
            <File Id="xiffd_x86" Name="xiffd.dll" DiskId="1"
                  Source="..\build\Release\Win32\xiffd.dll" />
            <RegistryKey Root="HKLM"
                         Key="SOFTWARE\Wow6432Node\Classes\CLSID\{FFB10360-5623-49AA-BD51-B321DB9625CE}"
                         ForceCreateOnInstall="yes" ForceDeleteOnUninstall="yes">
              <RegistryValue Type="string" Value="Force Feedback Driver for XInput" />
              <RegistryValue Key="InProcServer32" Type="string"
                             Value="[INSTALLDIR]x86\xiffd.dll" />
              <RegistryValue Key="InProcServer32" Name="ThreadingModel"
                             Type="string" Value="Both" />
            </RegistryKey>
          </Component>
        </Directory>

        <!-- OEMForceFeedback registry entries — one component per controller PID -->

        <Component Id="Registry_045E_028E" Guid="*">
          <RemoveRegistryKey Root="HKCU"
                             Key="System\CurrentControlSet\Control\MediaProperties\PrivateProperties\Joystick\OEM\VID_045E&amp;PID_028E"
                             Action="removeOnInstall" />
